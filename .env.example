# Both values are public by design — the publishable key ships to the
# browser. Row Level Security is what protects the data.
#
# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API keys.
#
# Never put the secret / service_role key in this project.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
